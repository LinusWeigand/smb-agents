# --- client (inlined into the bundle at build time; never put secrets here) ---
VITE_SITE_URL=https://www.limitless-stack.com
VITE_APP_URL=https://app.limitless-stack.com

# --- server only (Vercel environment variables) ---
# Neon connection string.
DATABASE_URL=
# Long random string; salts the hashed client IP used for rate limiting.
THROTTLE_SALT=
# Optional: lead notification email via Resend. Endpoints work without these.
RESEND_API_KEY=
LEAD_NOTIFY_FROM=
LEAD_NOTIFY_TO=
